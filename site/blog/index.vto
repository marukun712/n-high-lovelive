---
layout: layouts/base.vto
title: ブログ
type: page
---
<section>
  <h1>ブログ</h1>
  <p>同好会の活動やイベントの記録を掲載しています。</p>

  <ul class="posts">
    {{ for post of search.pages("type=post", "date=desc") }}
    <li>
      <a href="{{ post.url |> url }}">
        <time datetime="{{ post.date |> isoDate }}">{{ post.date |> date }}</time>
        {{ post.title }}
      </a>
      {{ if post.summary }}
      <p>{{ post.summary }}</p>
      {{ /if }}
    </li>
    {{ /for }}
  </ul>
</section>
