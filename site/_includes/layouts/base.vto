<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ if title }}{{ title }} - {{ siteName }}{{ else }}{{ siteName }}{{ /if }}</title>
    <meta name="description" content="{{ siteDescription }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;700&display=swap">
    <link rel="stylesheet" href="{{ '/styles.css' |> url }}">
  </head>

  <body>
    <header>
      <div>
        <a href="{{ '/' |> url }}">{{ siteName }}</a>
        <nav>
          <a href="{{ '/' |> url }}#about">About</a>
          <a href="{{ '/' |> url }}#join">参加方法</a>
          <a href="{{ '/blog/' |> url }}">ブログ</a>
        </nav>
      </div>
    </header>

    <main>
    {{ content }}
  </main>

    <footer>
      <div>
        <p>{{ siteName }}</p>
        <p>N中等部・N高グループ生のためのラブライブファンコミュニティ</p>
      </div>
    </footer>
  </body>
</html>
